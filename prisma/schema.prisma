generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String          @id @default(uuid())
  full_name       String
  email           String          @unique
  password_hash   String
  registration_ip String?
  role            String          @default("USER") // USER or ADMIN
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt
  certificates    Certificate[]
  security_events SecurityEvent[]
}

model Event {
  id                String        @id @default(uuid())
  name              String
  description       String?
  event_date        DateTime?
  organizer_name    String?
  signer_name       String?
  signer_title      String?
  certificate_title String        @default("CERTIFICATE OF APPRECIATION")
  completion_text   String        @default("for outstanding participation and successfully completing")
  template_path     String? // path to uploaded background (pdf/png/jpg), relative to /public. Null = default built-in design.
  logo_path         String? // path to uploaded logo image (png/jpg), relative to /public. Null = no logo.
  logo_position     String        @default("top-center") // top-left | top-center | top-right
  issuance_mode     String        @default("OPEN") // OPEN (self-service) or CLAIM (code/admin-issued only)
  is_active         Boolean       @default(true)
  created_by        String?
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt
  certificates      Certificate[]
  claim_codes       ClaimCode[]
}

model ClaimCode {
  id           String        @id @default(uuid())
  event_id     String
  code         String        @unique
  max_uses     Int           @default(1) // how many different users may redeem this same code
  used_count   Int           @default(0)
  note         String? // admin bookkeeping, e.g. "dibagikan di grup WhatsApp panitia"
  is_active    Boolean       @default(true) // admin can deactivate early to stop further claims
  created_by   String?
  created_at   DateTime      @default(now())
  event        Event         @relation(fields: [event_id], references: [id])
  certificates Certificate[]
}

model Certificate {
  id                 String     @id @default(uuid())
  user_id            String?
  event_id           String
  certificate_id     String     @unique // e.g. CERT-7F4A92D81C
  verification_token String?
  status             String     @default("ACTIVE") // ACTIVE, REVOKED
  claim_code_id      String? // set when this certificate was obtained by redeeming a ClaimCode
  claimed_at         DateTime?
  generation_ip      String?
  revoked_at         DateTime?
  revoked_reason     String?
  revoked_by         String?
  issued_at          DateTime   @default(now())
  created_at         DateTime   @default(now())
  updated_at         DateTime   @updatedAt
  user               User?      @relation(fields: [user_id], references: [id])
  event              Event      @relation(fields: [event_id], references: [id])
  claim_code         ClaimCode? @relation(fields: [claim_code_id], references: [id])

  @@unique([user_id, event_id])
}

model SecurityEvent {
  id          String   @id @default(uuid())
  user_id     String?
  ip_address  String
  event_type  String
  metadata    String?
  created_at  DateTime @default(now())
  user        User?    @relation(fields: [user_id], references: [id])
}

model RateLimit {
  id         String   @id @default(uuid())
  ip_address String
  endpoint   String
  hits       Int      @default(1)
  expires_at DateTime
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([ip_address, endpoint])
}
